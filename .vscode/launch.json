{
  "version": "0.2.0",
  "configurations": [
    // Plugin debug configuration
    {
      "name": "Attach to Logi Plugin Service",
      "type": "coreclr",
      "request": "attach",
      "windows": {
        "processName": "LogiPluginService.exe"
      },
      "osx": {
        "processName": "LogiPluginService"
      },
      "justMyCode": true
    },
    // NotificationWatcher debug configurations
    {
      "name": "Debug NotificationWatcher",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build NotificationWatcher (Debug)",
      "program": "${workspaceFolder}/NotificationWatcher/bin/Debug/net8.0-windows10.0.19041.0/NotificationWatcher.exe",
      "args": [],
      "cwd": "${workspaceFolder}/NotificationWatcher",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach to NotificationWatcher",
      "type": "coreclr",
      "request": "attach",
      "processName": "NotificationWatcher.exe"
    }
  ]
}
